00108463  // beq  x1, x1, +8       5 == 5                      TAKEN
06300413  // addi x8,  x0, 99      *** MUST NOT EXECUTE ***
00208463  // beq  x1, x2, +8       5 == -3                     not taken
00700493  // addi x9,  x0, 7
00209463  // bne  x1, x2, +8       5 != -3                     TAKEN
