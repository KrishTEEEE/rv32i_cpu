00117463  // bgeu x2, x1, +8       unsigned fffffffd >= 5      TAKEN       KEY
06300a13  // addi x20, x0, 99      *** MUST NOT EXECUTE ***
0020f463  // bgeu x1, x2, +8       unsigned 5 >= fffffffd      not taken   KEY
