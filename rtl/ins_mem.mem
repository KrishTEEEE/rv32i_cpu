//01eca023  // sw x30, 0(x25)       mem[16] = ffffffff
//01dca223  // sw x29, 4(x25)       mem[20] = 2a, +ve S-type offset
//ffecac23  // sw x30, -8(x25)      mem[8] = ffffffff, -ve S-type offset
