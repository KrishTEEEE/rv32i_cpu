0010c463  // blt  x1, x1, +8       signed 5 < 5    equality    not taken
00700713  // addi x14, x0, 7
00116463  // bltu x2, x1, +8       unsigned fffffffd < 5       not taken   KEY
00700793  // addi x15, x0, 7
0020e463  // bltu x1, x2, +8       unsigned 5 < fffffffd       TAKEN       KEY
06300813  // addi x16, x0, 99      *** MUST NOT EXECUTE ***
